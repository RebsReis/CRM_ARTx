# Modelo sem credenciais. Nao preencha nem versione segredos neste arquivo.
# Backend local: copie para .env na RAIZ do repositorio e preencha somente o .env.
# Producao: configure os valores no ambiente do backend (Render).
# DATABASE_URL tem precedencia; deixe vazia para continuar usando DB_*.

# URL opcional. Nunca preencher este modelo com credenciais reais.
# URL inteira exige percent-encoding no usuario/senha. Campos DB_* recebem valores literais.
DATABASE_URL=

# PostgreSQL: obrigatorias se DATABASE_URL estiver vazia. Conta de privilegios minimos.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Backend: origens do FRONTEND autorizadas a fazer requisicoes.
# Desenvolvimento: valores abaixo. Producao: substitua pelos dominios HTTPS reais.
# Informe origens separadas por virgula, sem caminhos e sem barra final.
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# URL do frontend usada nos links de verificacao e recuperacao de senha.
APP_PUBLIC_URL=http://localhost:3000

# false somente em desenvolvimento HTTP. Em producao HTTPS, use true.
AUTH_COOKIE_SECURE=false

# Documentacao interativa (/docs, /redoc, /openapi.json). Abre sem login: mantenha false em producao.
API_DOCS_ENABLED=false

# E-mail: necessario para recuperacao de senha e verificacao de mudanca de e-mail.
# SMTP_HOST e SMTP_FROM sao obrigatorios para habilitar o envio.
# Use SMTP_SECURITY=starttls com porta 587, ou ssl com porta 465.
# SMTP_USER/SMTP_PASSWORD dependem da autenticacao exigida pelo provedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# A configuracao do proxy Next.js fica em frontend/.env.example.
# Nao adicionar credenciais Google: essa integracao esta desabilitada.

# Etapa 3: configuracao opcional do driver/pool, sem alterar o .env existente.
# Vazio preserva TLS padrao local. Neon usa verify-full + raiz system por padrao.
# system requer libpq >=17; pode indicar um bundle CA confiavel.
DB_SSLMODE=
DB_SSLROOTCERT=
DB_CHANNEL_BINDING=
DB_CONNECT_TIMEOUT=10
DB_POOL_MODE=queue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=-1
# Vazio: padrao do driver; no Neon -pooler desativa prepare automatico.
# Valor inteiro >=0 ou none para desativar.
DB_PREPARE_THRESHOLD=

# Exclusiva do Alembic, conexao DIRETA e nunca preenchida neste modelo.
# Nao ha fallback para a conexao da API. Nao executar migracoes sem autorizacao.
MIGRATION_DATABASE_URL=
